{
  "schema_version": "devboxes.catalog.example.v1",
  "status": "planned_template",
  "domain": "AI Developer DevBoxes",
  "governance_domain": "SELF-HARNESS/SELF-ENVIRONMENTS",
  "source_owner": "environments-harness-self",
  "resource_scope": "project",
  "domain_entry": "runbooks/26-ai-developer-devboxes.md",
  "format_owner": "the domain runbook; document data, not an adopted runtime adapter",
  "private_state_pattern": ".local/devboxes/instances/gcp-gptgrep-devbox-01/",
  "instance_example": {
    "id": "gcp-gptgrep-devbox-01",
