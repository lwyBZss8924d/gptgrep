{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GPTgrep paired report metadata input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cohort_sha256",
    "configuration_sha256",
    "campaign_final",
    "tasks",
    "repeats",
    "outcomes",
    "judge_rubric_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "gptgrep.harbor.paired-input.v1"
    },
    "cohort_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "configuration_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "campaign_final": {
      "type": "boolean"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "document_group"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "document_group": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          }
        }
      }
    },
    "repeats": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295
      }
    },
    "outcomes": {
      "type": "array",
      "maxItems": 262144,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "repeat",
          "arm",
          "operational_status",
          "judge_status",
          "query_wall_scope",
          "cohort_sha256",
          "configuration_sha256"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "repeat": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "arm": {
            "enum": [
              "control",
              "gptgrep"
            ]
          },
          "operational_status": {
            "enum": [
              "unexecuted",
              "pending",
              "unknown",
              "completed",
              "failed"
            ]
          },
          "terminal_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "answer_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "failure_reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "judge_status": {
            "enum": [
              "not_attempted",
              "pending",
              "completed",
              "unavailable"
            ]
          },
          "equivalent": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "query_wall_ms": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "query_wall_scope": {
            "enum": [
              "unavailable",
              "task_delivery_to_query_terminal"
            ]
          },
          "native_latency_ms": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "cohort_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "configuration_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "judge_receipt_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "judged_answer_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "judge_rubric_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "judge_rubric_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "description": "The Rust reporter additionally enforces semantic state/terminal/equivalence/clock consistency, unique joins, outcome count and final terminal completeness. Contains metadata and digests only; never question, answer, reference or tool payload text."
}
