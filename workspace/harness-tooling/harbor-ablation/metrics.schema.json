{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prospective paired Harbor resource and reward observations",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "repeat", "arm", "status", "reward", "preprocessing", "reader", "judge"],
  "properties": {
    "task_id": {"type": "string"},
    "repeat": {"type": "integer", "minimum": 0},
    "arm": {"enum": ["control", "gptgrep"]},
    "status": {"enum": ["unexecuted", "succeeded", "failed", "verification_unavailable"]},
    "reward": {"type": ["number", "null"], "enum": [0, 1, null]},
    "preprocessing": {"$ref": "#/$defs/resources"},
    "reader": {"$ref": "#/$defs/resources"},
    "judge": {"$ref": "#/$defs/resources"}
  },
  "$defs": {
    "resources": {
      "type": "object", "additionalProperties": false,
      "required": ["request_count", "latency_ms", "input_tokens", "output_tokens", "cost_usd", "cost_known", "failures"],
      "properties": {
        "request_count": {"type": ["integer", "null"], "minimum": 0},
        "latency_ms": {"type": ["integer", "null"], "minimum": 0},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cost_usd": {"type": ["string", "null"]},
        "cost_known": {"type": "boolean"},
        "failures": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  }
}
