+//! Required, process-local admission for isolated GPTgrep OCR and document runtimes.
+//!
+//! This module is absent from the ordinary upstream runtime. A page child opts in
+//! through a sealed manifest before initialize; no model-visible tool can change
+//! the manifest, the original clock, the counter, or its image grants.
+use base64::Engine;
+use codex_protocol::models::PermissionProfile;
+use codex_protocol::openai_models::ReasoningEffort;
+use codex_protocol::protocol::AskForApproval;
+use codex_tools::ToolName;
+use serde::Deserialize;
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+use std::collections::{BTreeMap, BTreeSet};
+use std::fs::{self, File, OpenOptions};
+use std::io::{BufRead, BufReader, Read, Seek, SeekFrom, Write};
+use std::path::{Component, Path, PathBuf};
+use std::sync::{Mutex, OnceLock};
+use std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};
+
+use crate::session::turn_context::TurnContext;
+
+const MANIFEST_SCHEMA: &str = "gptgrep.native-ocr.admission.v1";
+const READY_SCHEMA: &str = "gptgrep.native-ocr.ready.v1";
+const RECEIPT_SCHEMA: &str = "gptgrep.native-ocr.receipt.v1";
+const MANIFEST_LIMIT: usize = 64 * 1024;
+const RECEIPT_LIMIT: usize = 16 * 1024;
+const MAX_TOOLS: u32 = 8;
+const MAX_SECONDS: u64 = 180;
+const FRAME_LIMIT: u64 = 4 * 1024 * 1024;
+const IMAGE_WIRE_RESERVATION: u64 = 8 * 1024 * 1024;
+const PIXEL_WORKING_LIMIT: u64 = 64 * 1024 * 1024;
+const PROFILE_ID: &str = "gptgrep_native_ocr";
+const DOCUMENT_MANIFEST_SCHEMA: &str = "gptgrep.native-document.admission.v1";
+const DOCUMENT_READY_SCHEMA: &str = "gptgrep.native-document.ready.v1";
+const DOCUMENT_RECEIPT_SCHEMA: &str = "gptgrep.native-document.receipt.v1";
+const DOCUMENT_PROFILE_ID: &str = "gptgrep_native_document";
+const DOCUMENT_MAX_TOOLS: u32 = 64;
+const DOCUMENT_MAX_SECONDS: u64 = 900;
+const DOCUMENT_IMAGE_WIRE_RESERVATION: u64 = 32 * 1024 * 1024;
+const CATALOGUE_LIMIT: u64 = 4 * 1024 * 1024;
+const CATALOGUE_ROW_LIMIT: usize = 8192;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum GuardKind { Page, Document }
+
+impl GuardKind {
+    fn max_tools(self) -> u32 { match self { Self::Page => MAX_TOOLS, Self::Document => DOCUMENT_MAX_TOOLS } }
+    fn max_seconds(self) -> u64 { match self { Self::Page => MAX_SECONDS, Self::Document => DOCUMENT_MAX_SECONDS } }
+    fn image_wire_reservation(self) -> u64 { match self { Self::Page => IMAGE_WIRE_RESERVATION, Self::Document => DOCUMENT_IMAGE_WIRE_RESERVATION } }
+    fn profile_id(self) -> &'static str { match self { Self::Page => PROFILE_ID, Self::Document => DOCUMENT_PROFILE_ID } }
+    fn manifest_schema(self) -> &'static str { match self { Self::Page => MANIFEST_SCHEMA, Self::Document => DOCUMENT_MANIFEST_SCHEMA } }
+    fn ready_schema(self) -> &'static str { match self { Self::Page => READY_SCHEMA, Self::Document => DOCUMENT_READY_SCHEMA } }
+    fn receipt_schema(self) -> &'static str { match self { Self::Page => RECEIPT_SCHEMA, Self::Document => DOCUMENT_RECEIPT_SCHEMA } }
+    fn context_name(self) -> &'static str { match self { Self::Page => "ocr_resource", Self::Document => "toolbox" } }
+    fn context_namespace(self) -> &'static str { match self { Self::Page => "gptgrep_ocr", Self::Document => "gptgrep_parse" } }
+    fn context_key(self) -> &'static str { match self { Self::Page => "gptgrep_ocr.ocr_resource", Self::Document => "gptgrep_parse.toolbox" } }
+    fn environment_names(self) -> [&'static str; 3] {
+        match self {
+            Self::Page => ["GPTGREP_NATIVE_OCR_REQUIRED", "GPTGREP_NATIVE_OCR_ADMISSION", "GPTGREP_NATIVE_OCR_ADMISSION_SHA256"],
+            Self::Document => ["GPTGREP_NATIVE_DOCUMENT_REQUIRED", "GPTGREP_NATIVE_DOCUMENT_ADMISSION", "GPTGREP_NATIVE_DOCUMENT_ADMISSION_SHA256"],
+        }
+    }
+}
+
+fn select_kind(page: [bool; 3], document: [bool; 3]) -> AdmissionResult<Option<GuardKind>> {
+    match (page.iter().any(|v| *v), document.iter().any(|v| *v)) {
+        (false, false) => Ok(None),
+        (true, false) => Ok(Some(GuardKind::Page)),
+        (false, true) => Ok(Some(GuardKind::Document)),
+        (true, true) => Err("native_modes_ambiguous"),
+    }
+}
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ImageCataloguePin {
+    path: PathBuf,
+    bytes: u64,
+    sha256: String,
+    count: u32,
+}
+
+type AdmissionResult<T> = Result<T, &'static str>;
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct ImageGrant {
+    pub artifact_id: String,
+    pub relative_path: PathBuf,
+    pub bytes: u64,
+    pub sha256: String,
+    pub width: u32,
+    pub height: u32,
+    pub rendition_sha256: String,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct AdmissionManifest {
+    schema_version: String,
+    task_sha256: String,
+    source_sha256: String,
+    prepared_sha256: String,
+    runtime_profile_sha256: String,
+    deadline_unix_ms: u64,
+    max_tool_calls: u32,
+    max_turns: u32,
+    frame_bytes: u64,
+    image_transport_reserved_bytes: u64,
+    image_root: PathBuf,
+    receipt_root: PathBuf,
+    permissions_profile_sha256: String,
+    images: Vec<ImageGrant>,
+    #[serde(default)]
+    image_catalog: Option<ImageCataloguePin>,
+}
+
+#[derive(Debug)]
+struct Guard {
+    kind: GuardKind,
+    catalogue: Option<Mutex<File>>,
+    manifest: AdmissionManifest,
+    manifest_sha256: String,
+    deadline: Instant,
+    expected_permissions: Value,
+    image_directory: File,
+    receipt_directory: File,
+    state: Mutex<State>,
+}
+
+#[derive(Debug, Default)]
+struct State {
+    turn_id: Option<String>,
+    turns: u32,
+    submissions: u32,
+    calls: BTreeMap<String, Call>,
+    image_wire_bytes: u64,
+    violation: Option<&'static str>,
+}
+
+#[derive(Debug)]
+struct Call {
+    ordinal: u32,
+    native_image: bool,
+    dispatched: bool,
+    grant: Option<ImageGrant>,
+    source_verified: bool,
+    prepared: Option<PreparedBinding>,
+    assembled: bool,
+}
+
+#[derive(Debug, Clone)]
+struct PreparedBinding {
+    bytes: u64,
+    sha256: String,
+    width: u32,
+    height: u32,
+    wire_bytes: u64,
+}
+
+static GUARD: OnceLock<AdmissionResult<Option<Guard>>> = OnceLock::new();
+
+fn digest(bytes: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(bytes))
+}
+
+fn valid_digest(value: &str) -> bool {
+    value.len() == 64 && value.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+}
+
+fn get() -> AdmissionResult<Option<&'static Guard>> {
+    match GUARD.get_or_init(load) {
+        Ok(guard) => Ok(guard.as_ref()),
+        Err(error) => Err(*error),
+    }
+}
+
+/// A required flag cannot degrade to ordinary unguarded behavior.
+fn load() -> AdmissionResult<Option<Guard>> {
+    let page = GuardKind::Page.environment_names().map(|name| std::env::var_os(name).is_some());
+    let document = GuardKind::Document.environment_names().map(|name| std::env::var_os(name).is_some());
+    let Some(kind) = select_kind(page, document)? else { return Ok(None); };
+    let [required_name, path_name, digest_name] = kind.environment_names();
+    let required = std::env::var_os(required_name);
+    let path = std::env::var_os(path_name);
+    let expected = std::env::var_os(digest_name);
+    if required.as_deref() != Some(std::ffi::OsStr::new("1")) {
+        return Err("native_ocr_required_flag");
+    }
+    let path = PathBuf::from(path.ok_or("native_ocr_admission_missing")?);
+    let expected = expected
+        .and_then(|value| value.into_string().ok())
+        .ok_or("native_ocr_admission_digest_missing")?;
+    if !valid_digest(&expected) {
+        return Err("native_ocr_admission_digest");
+    }
+    let bytes = read_sealed_file(&path, MANIFEST_LIMIT as u64)?;
+    if digest(&bytes) != expected {
+        return Err("native_ocr_admission_changed");
+    }
+    let manifest: AdmissionManifest = serde_json::from_slice(&bytes)
+        .map_err(|_| "native_ocr_admission_schema")?;
+    validate_manifest(&manifest, kind)?;
+    let now_ms = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_err(|_| "native_ocr_clock")?
+        .as_millis();
+    let remaining = u128::from(manifest.deadline_unix_ms)
+        .checked_sub(now_ms)
+        .ok_or("native_ocr_deadline_expired")?;
+    if remaining == 0 || remaining > u128::from(kind.max_seconds() * 1000) {
+        return Err("native_ocr_deadline_out_of_range");
+    }
+    let deadline = Instant::now()
+        .checked_add(Duration::from_millis(remaining as u64))
+        .ok_or("native_ocr_clock")?;
+    let expected_permissions = permission_value(&manifest, kind);
+    if digest(&serde_json::to_vec(&expected_permissions)
+        .map_err(|_| "native_ocr_permission_serialization")?) != manifest.permissions_profile_sha256
+    {
+        return Err("native_ocr_permission_digest");
+    }
+    let image_directory = open_directory(&manifest.image_root)?;
+    let receipt_directory = open_directory(&manifest.receipt_root)?;
+    let catalogue = manifest.image_catalog.as_ref().map(open_catalogue).transpose()?.map(Mutex::new);
+    let guard = Guard {
+        kind, catalogue,
+        manifest,
+        manifest_sha256: expected,
+        deadline,
+        expected_permissions,
+        image_directory,
+        receipt_directory,
+        state: Mutex::new(State::default()),
+    };
+    guard.write_receipt("ready.json", &guard.ready_value())?;
+    Ok(Some(guard))
+}
+
+fn validate_manifest(manifest: &AdmissionManifest, kind: GuardKind) -> AdmissionResult<()> {
+    if manifest.schema_version != kind.manifest_schema()
+        || manifest.max_tool_calls != kind.max_tools()
+        || manifest.max_turns != 1
+        || manifest.frame_bytes != FRAME_LIMIT
+        || manifest.image_transport_reserved_bytes != kind.image_wire_reservation()
+        || (kind == GuardKind::Page && (manifest.images.is_empty()
+            || manifest.images.len() > MAX_TOOLS as usize || manifest.image_catalog.is_some()))
+        || (kind == GuardKind::Document && (!manifest.images.is_empty() || manifest.image_catalog.is_none()))
+    {
+        return Err("native_ocr_admission_limits");
+    }
+    for value in [
+        &manifest.task_sha256,
+        &manifest.source_sha256,
+        &manifest.prepared_sha256,
+        &manifest.runtime_profile_sha256,
+        &manifest.permissions_profile_sha256,
+    ] {
+        if !valid_digest(value) {
+            return Err("native_ocr_admission_binding");
+        }
+    }
+    validate_absolute(&manifest.image_root)?;
+    validate_absolute(&manifest.receipt_root)?;
+    if manifest.image_root.starts_with(&manifest.receipt_root)
+        || manifest.receipt_root.starts_with(&manifest.image_root)
+    {
+        return Err("native_ocr_root_overlap");
+    }
+    if let Some(pin) = &manifest.image_catalog {
+        validate_absolute(&pin.path)?;
+        if !valid_digest(&pin.sha256) || pin.bytes > CATALOGUE_LIMIT
+            || u64::from(pin.count) > pin.bytes
+            || pin.path.starts_with(&manifest.image_root)
+            || pin.path.starts_with(&manifest.receipt_root)
+        { return Err("native_document_catalogue_binding"); }
+    }
+    let mut paths = BTreeSet::new();
+    let mut ids = BTreeSet::new();
+    for grant in &manifest.images {
+        validate_grant(grant)?;
+        if !paths.insert(grant.relative_path.clone()) || !ids.insert(grant.artifact_id.clone()) {
+            return Err("native_ocr_image_grant");
+        }
+    }
+    Ok(())
+}
+
+fn validate_grant(grant: &ImageGrant) -> AdmissionResult<()> {
+    let mut parts = grant.relative_path.components();
+    if !matches!(parts.next(), Some(Component::Normal(_))) || parts.next().is_some()
+        || grant.artifact_id.is_empty() || grant.artifact_id.len() > 256
+        || !valid_digest(&grant.sha256) || !valid_digest(&grant.rendition_sha256)
+        || grant.bytes == 0 || grant.bytes > FRAME_LIMIT
+        || grant.width == 0 || grant.height == 0
+        || u64::from(grant.width) * u64::from(grant.height) > PIXEL_WORKING_LIMIT / 4
+    { return Err("native_ocr_image_grant"); }
+    Ok(())
+}
+
+fn permission_value(manifest: &AdmissionManifest, kind: GuardKind) -> Value {
+    let mut entries = vec![json!({
+        "path":{"type":"special","value":{"kind":"root"}},"access":"deny"
+    })];
+    if kind == GuardKind::Document {
+        // The guard still checks each single leaf against the complete sealed catalogue.
+        // The directory grants filesystem access only; it grants no shell/read tool.
+        entries.push(json!({"path":{"type":"path","path":manifest.image_root},"access":"read"}));
+    } else {
+        for grant in &manifest.images {
+            entries.push(json!({
+                "path":{"type":"path","path":manifest.image_root.join(&grant.relative_path)},
+                "access":"read"
+            }));
+        }
+    }
+    entries.sort_by_key(|entry| canonical_value(entry.clone()).to_string());
+    canonical_value(json!({"type":"managed","network":"restricted",
+        "file_system":{"type":"restricted","entries":entries}}))
+}
+
+// Explicit key order makes the digest independent of serde_json preserve_order.
+fn canonical_value(value: Value) -> Value {
+    match value {
+        Value::Object(object) => {
+            let mut pairs: Vec<_> = object.into_iter().collect();
+            pairs.sort_by(|left, right| left.0.cmp(&right.0));
+            let mut result = serde_json::Map::new();
+            for (key, value) in pairs {
+                result.insert(key, canonical_value(value));
+            }
+            Value::Object(result)
+        }
+        Value::Array(values) => Value::Array(values.into_iter().map(canonical_value).collect()),
+        other => other,
+    }
+}
+
+fn normalized_permissions(profile: &PermissionProfile) -> AdmissionResult<Value> {
+    let mut value = canonical_value(serde_json::to_value(profile)
+        .map_err(|_| "native_ocr_permission_serialization")?);
+    let entries = value.pointer_mut("/file_system/entries").and_then(Value::as_array_mut)
+        .ok_or("native_ocr_permission_shape")?;
+    entries.sort_by_key(|entry| entry.to_string());
+    Ok(value)
+}
+
+fn validate_environment_selection(
+    selection: &codex_protocol::protocol::TurnEnvironmentSelection,
+    image_root: &Path,
+) -> AdmissionResult<()> {
+    if selection.environment_id != codex_exec_server::LOCAL_ENVIRONMENT_ID
+        || selection.cwd.to_abs_path().ok().as_ref().map(|path| path.as_path())
+            != Some(image_root)
+        || !selection.workspace_roots.is_empty()
+        || selection.selected_capability_roots != Default::default()
+    {
+        return Err("native_ocr_environment_selection");
+    }
+    Ok(())
+}
+
+impl Guard {
+    fn ready_value(&self) -> Value {
+        let mut value = json!({
+            "schema_version":self.kind.ready_schema(),"required":true,
+            "admission_sha256":self.manifest_sha256,
+            "task_sha256":self.manifest.task_sha256,
+            "source_sha256":self.manifest.source_sha256,
+            "prepared_sha256":self.manifest.prepared_sha256,
+            "runtime_profile_sha256":self.manifest.runtime_profile_sha256,
+            "permissions_profile_id":self.kind.profile_id(),
+            "permissions_profile_sha256":self.manifest.permissions_profile_sha256,
+            "environment_ids":[codex_exec_server::LOCAL_ENVIRONMENT_ID],
+            "environment_id_argument_admitted":false,
+            "max_tool_calls":self.kind.max_tools(),"max_turns":1,"max_seconds":self.kind.max_seconds(),
+            "deadline_unix_ms":self.manifest.deadline_unix_ms,
+            "frame_bytes":FRAME_LIMIT,
+            "image_transport_reserved_bytes":self.kind.image_wire_reservation(),
+            "tool_counter_before_lookup_hooks_handler":true,
+            "tool_counter_before_argument_parse":true,
+            "normalized_request_profile_verified_before_send":true,
+            "native_image_read_bounded":true,
+            "assembled_image_receipts_required":true,
+            "requested_model":"gpt-6-luna","requested_effort":"max",
+            "normalized_request_service_tier":"priority",
+            "actual_served_profile_verified":false
+        });
+        if let Some(pin) = &self.manifest.image_catalog {
+            value["image_catalog_sha256"] = json!(pin.sha256);
+            value["image_catalog_count"] = json!(pin.count);
+        }
+        value
+    }
+
+    fn check(&self, state: &State) -> AdmissionResult<()> {
+        if let Some(error) = state.violation {
+            return Err(error);
+        }
+        if Instant::now() >= self.deadline {
+            return Err("native_ocr_deadline_expired");
+        }
+        same_directory(&self.manifest.image_root, &self.image_directory)?;
+        same_directory(&self.manifest.receipt_root, &self.receipt_directory)?;
+        if let (Some(pin), Some(file)) = (&self.manifest.image_catalog, &self.catalogue) {
+            let file = file.lock().map_err(|_| "native_document_catalogue_poisoned")?;
+            same_regular_file(&pin.path, &file)?;
+        }
+        Ok(())
+    }
+
+    fn fail<T>(&self, state: &mut State, error: &'static str) -> AdmissionResult<T> {
+        state.violation.get_or_insert(error);
+        // The original error remains fatal even if the bounded receipt cannot be written.
+        let _ = self.write_receipt("violation.json", &json!({
+            "schema_version":self.kind.receipt_schema(),"kind":"violation",
+            "admission_sha256":self.manifest_sha256,"task_sha256":self.manifest.task_sha256,
+            "error":state.violation,"submissions":state.submissions,"turns":state.turns,
+            "image_wire_bytes":state.image_wire_bytes,"accepted":false
+        }));
+        Err(error)
+    }
+
+    fn write_receipt(&self, leaf: &str, value: &Value) -> AdmissionResult<()> {
+        same_directory(&self.manifest.receipt_root, &self.receipt_directory)?;
+        let bytes = serde_json::to_vec(value).map_err(|_| "native_ocr_receipt_serialization")?;
+        if bytes.len() > RECEIPT_LIMIT {
+            return Err("native_ocr_receipt_limit");
+        }
+        let mut file = create_leaf(&self.receipt_directory, leaf)?;
+        file.write_all(&bytes).map_err(|_| "native_ocr_receipt_write")?;
+        file.sync_all().map_err(|_| "native_ocr_receipt_sync")?;
+        Ok(())
+    }
+}
