+// Classification borrows the raw item and never parses arguments first.
+fn raw_tool_parts(item: &codex_protocol::models::ResponseItem)
+    -> Option<(&str, Option<&str>, Option<&str>)>
+{
+    use codex_protocol::models::ResponseItem;
+    match item {
+        ResponseItem::FunctionCall { name, namespace, call_id, .. }
+        | ResponseItem::CustomToolCall { name, namespace, call_id, .. } =>
+            Some((name, namespace.as_deref(), Some(call_id))),
+        ResponseItem::ToolSearchCall { call_id, .. } =>
+            Some(("tool_search", None, call_id.as_deref())),
+        ResponseItem::LocalShellCall { call_id, .. } =>
+            Some(("local_shell", None, call_id.as_deref())),
+        ResponseItem::WebSearchCall { .. } => Some(("web_search", None, None)),
+        ResponseItem::ImageGenerationCall { .. } => Some(("image_generation", None, None)),
+        _ => None,
+    }
+}
