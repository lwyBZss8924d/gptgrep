+impl Guard {
+fn admit_model_tool(
+    &self, turn_id: &str, item: &codex_protocol::models::ResponseItem,
+    active_count: Option<u64>,
+) -> AdmissionResult<()> {
+    let Some((name, namespace, call_id)) = raw_tool_parts(item) else {
+        return Err("native_ocr_raw_tool_missing");
+    };
+    // Bound identity cloning, while still consuming an invalid proposal.
+    let tool = if name.len() <= 128 && namespace.is_none_or(|value| value.len() <= 128) {
+        ToolName::new(namespace.map(str::to_owned), name)
+    } else {
+        ToolName::plain("invalid_native_identity")
+    };
+    self.admit_tool(turn_id, &tool, call_id.unwrap_or(""), active_count)
+}
+
+fn verify_dispatched_tool(
+    &self, turn_id: &str, tool: &ToolName, call_id: &str, active_count: Option<u64>,
+) -> AdmissionResult<()> {
+    let mut state = self.state.lock().map_err(|_| "native_ocr_guard_poisoned")?;
+    if let Err(error) = self.check(&state) { return self.fail(&mut state, error); }
+    if state.turn_id.as_deref() != Some(turn_id)
+        || active_count != Some(u64::from(state.submissions))
+    { return self.fail(&mut state, "native_ocr_active_state_missing_or_changed"); }
+    let Some(call) = state.calls.get(call_id) else {
+        return self.fail(&mut state, "native_ocr_dispatch_not_pre_admitted");
+    };
+    let image = tool.name == "view_image" && tool.is_default_namespace();
+    let context = tool.name == self.kind.context_name() && tool.namespace.as_deref() == Some(self.kind.context_namespace());
+    if call.dispatched || call.native_image != image || (!image && !context) {
+        return self.fail(&mut state, "native_ocr_dispatch_changed_or_repeated");
+    }
+    state.calls.get_mut(call_id).ok_or("native_ocr_dispatch_not_pre_admitted")?.dispatched = true;
+    Ok(())
+}
+
+fn before_wire_request(
+    &self, model: &str, effort: Option<&ReasoningEffort>, tier: Option<&str>,
+    tools: Option<&Value>, warmup: bool,
+) -> AdmissionResult<()> {
+    let mut state = self.state.lock().map_err(|_| "native_ocr_guard_poisoned")?;
+    if let Err(error) = self.check(&state) { return self.fail(&mut state, error); }
+    if model != "gpt-6-luna" || effort.map(ReasoningEffort::as_str) != Some("max")
+        || tier != Some("priority")
+        || (!warmup && (state.turns != 1 || state.turn_id.is_none()
+            || state.calls.values().any(|call| call.native_image && !call.assembled)))
+    {
+        return self.fail(&mut state, "native_ocr_normalized_request_profile");
+    }
+    if let Err(error) = validate_model_tools(tools, self.kind) { return self.fail(&mut state, error); }
+    Ok(())
+}
+
+fn admit_tool(&self, 
+    turn_id: &str, tool: &ToolName, call_id: &str, active_count: Option<u64>,
+) -> AdmissionResult<()> {
+    let guard = self;
+    let mut state = guard.state.lock().map_err(|_| "native_ocr_guard_poisoned")?;
+    state.submissions = state.submissions.checked_add(1).ok_or("native_ocr_counter_overflow")?;
+    if let Err(error) = guard.check(&state) { return guard.fail(&mut state, error); }
+    if state.turn_id.as_deref() != Some(turn_id)
+        || active_count != Some(u64::from(state.submissions))
+    { return guard.fail(&mut state, "native_ocr_active_state_missing_or_changed"); }
+    if state.submissions > guard.kind.max_tools() {
+        return guard.fail(&mut state, "native_ocr_tool_budget_exhausted");
+    }
+    if call_id.is_empty() || call_id.len() > 256 || state.calls.contains_key(call_id) {
+        return guard.fail(&mut state, "native_ocr_duplicate_or_invalid_call");
+    }
+    let native_image = tool.name == "view_image" && tool.is_default_namespace();
+    let context = tool.name == guard.kind.context_name()
+        && tool.namespace.as_deref() == Some(guard.kind.context_namespace());
+    if !native_image && !context {
+        return guard.fail(&mut state, "native_ocr_tool_not_admitted");
+    }
+    let ordinal = state.submissions;
+    if let Err(error) = guard.write_receipt(&format!("call-{ordinal}.json"), &json!({
+        "schema_version":guard.kind.receipt_schema(),"kind":"tool_admitted",
+        "admission_sha256":guard.manifest_sha256,"task_sha256":guard.manifest.task_sha256,
+        "turn_id":turn_id,"call_id":call_id,"ordinal":ordinal,
+        "native_image":native_image,"handler_not_yet_executed":true,
+        "argument_parser_not_yet_executed":true
+    })) { return guard.fail(&mut state, error); }
+    state.calls.insert(call_id.into(), Call { ordinal, native_image, dispatched:false, grant:None,
+        source_verified:false, prepared:None, assembled:false });
+    Ok(())
+}
+
+fn image_grant(&self, 
+    call_id: &str, path: &Path, environment_id: Option<&str>, permissions: &PermissionProfile,
+) -> AdmissionResult<Option<ImageGrant>> {
+    let guard = self;
+    let mut state = guard.state.lock().map_err(|_| "native_ocr_guard_poisoned")?;
+    if let Err(error) = guard.check(&state) { return guard.fail(&mut state, error); }
+    let actual = normalized_permissions(permissions)?;
+    if environment_id.is_some() || actual != guard.expected_permissions {
+        return guard.fail(&mut state, "native_ocr_image_environment_or_permissions");
+    }
+    let grant = if guard.kind == GuardKind::Document {
+        let relative = path.strip_prefix(&guard.manifest.image_root)
+            .map_err(|_| "native_document_image_not_granted")?;
+        let pin = guard.manifest.image_catalog.as_ref()
+            .ok_or("native_document_catalogue_missing")?;
+        let mut file = guard.catalogue.as_ref().ok_or("native_document_catalogue_missing")?
+            .lock().map_err(|_| "native_document_catalogue_poisoned")?;
+        match scan_catalogue(&mut file, pin, Some(relative)) {
+            Ok(value) => value,
+            Err(error) => return guard.fail(&mut state, error),
+        }
+    } else {
+        guard.manifest.images.iter().find(|grant| {
+            path == guard.manifest.image_root.join(&grant.relative_path)
+        }).cloned()
+    };
+    let Some(grant) = grant else { return guard.fail(&mut state, "native_ocr_image_not_granted"); };
+    let Some(call) = state.calls.get(call_id) else {
+        return guard.fail(&mut state, "native_ocr_image_call_not_admitted");
+    };
+    if !call.native_image || !call.dispatched || call.grant.is_some() {
+        return guard.fail(&mut state, "native_ocr_image_call_changed");
+    }
+    // Check the leaf through the held directory; never hash or read an ungranted path.
+    let file = open_leaf(&guard.image_directory, &grant.relative_path)?;
+    let metadata = file.metadata().map_err(|_| "native_ocr_image_metadata")?;
+    if !metadata.is_file() || metadata.len() != grant.bytes {
+        return guard.fail(&mut state, "native_ocr_image_size_changed");
+    }
+    state.calls.get_mut(call_id).ok_or("native_ocr_image_call_not_admitted")?.grant = Some(grant.clone());
+    Ok(Some(grant))
+}
+
+fn source_buffer(&self, call_id: &str, bytes: &[u8]) -> AdmissionResult<()> {
+    let guard = self;
+    let mut state = guard.state.lock().map_err(|_| "native_ocr_guard_poisoned")?;
+    if let Err(error) = guard.check(&state) { return guard.fail(&mut state, error); }
+    let Some(call) = state.calls.get(call_id) else {
+        return guard.fail(&mut state, "native_ocr_image_call_not_admitted");
+    };
+    let Some(grant) = call.grant.clone() else {
+        return guard.fail(&mut state, "native_ocr_image_grant_missing");
+    };
+    let ordinal = call.ordinal;
+    if bytes.len() as u64 != grant.bytes || digest(bytes) != grant.sha256 {
+        return guard.fail(&mut state, "native_ocr_image_buffer_changed");
+    }
+    let reader = image::ImageReader::new(std::io::Cursor::new(bytes))
+        .with_guessed_format().map_err(|_| "native_ocr_image_format")?;
+    let (width, height) = reader.into_dimensions().map_err(|_| "native_ocr_image_dimensions")?;
+    if (width,height) != (grant.width,grant.height)
+        || u64::from(width) * u64::from(height) > PIXEL_WORKING_LIMIT / 4
+    { return guard.fail(&mut state, "native_ocr_image_dimensions_changed"); }
+    if let Err(error) = guard.write_receipt(&format!("source-{ordinal}.json"), &json!({
+        "schema_version":guard.kind.receipt_schema(),"kind":"native_source_buffer",
+        "admission_sha256":guard.manifest_sha256,"task_sha256":guard.manifest.task_sha256,
+        "call_id":call_id,"ordinal":ordinal,"artifact_id":grant.artifact_id,
+        "source_buffer_bytes":bytes.len(),"source_buffer_sha256":grant.sha256,
+        "source_width":width,"source_height":height,"rendition_sha256":grant.rendition_sha256
+    })) { return guard.fail(&mut state, error); }
+    state.calls.get_mut(call_id).ok_or("native_ocr_image_call_not_admitted")?.source_verified = true;
+    Ok(())
+}
+
+fn prepared_image(&self, 
+    call_id: Option<&str>, bytes: &[u8], mime: &str, width: u32, height: u32,
+    detail: Option<codex_protocol::models::ImageDetail>,
+) -> AdmissionResult<()> {
+    let guard = self;
+    let mut state = guard.state.lock().map_err(|_| "native_ocr_guard_poisoned")?;
+    if let Err(error) = guard.check(&state) { return guard.fail(&mut state, error); }
+    let Some(call_id) = call_id else { return guard.fail(&mut state, "native_ocr_assembly_call_missing"); };
+    let Some(call) = state.calls.get(call_id) else {
+        return guard.fail(&mut state, "native_ocr_assembly_call_unknown");
+    };
+    let Some(grant) = call.grant.clone() else {
+        return guard.fail(&mut state, "native_ocr_assembly_grant_missing");
+    };
+    let ordinal = call.ordinal;
+    if !call.native_image || !call.source_verified || call.prepared.is_some() || call.assembled
+        || width == 0 || height == 0
+        || u64::from(width) * u64::from(height) > PIXEL_WORKING_LIMIT / 4
+    { return guard.fail(&mut state, "native_ocr_assembly_changed"); }
+    // Forecast exact base64 plus serialized framing before allocating either.
+    // Base64 characters need no JSON escaping; mime and call identity framing do.
+    let wire_bytes = planned_image_wire_bytes(call_id, bytes.len(), mime, detail)?;
+    let next = state.image_wire_bytes.checked_add(wire_bytes).ok_or("native_ocr_transport_overflow")?;
+    if wire_bytes > FRAME_LIMIT || next > guard.kind.image_wire_reservation() {
+        return guard.fail(&mut state, "native_ocr_image_wire_budget_exhausted");
+    }
+    let image_url = format!("data:{mime};base64,{}", base64::engine::general_purpose::STANDARD.encode(bytes));
+    let actual_wire = image_wire_bytes(call_id,
+        codex_protocol::models::ImageReference::Inline { image_url }, detail)?;
+    if actual_wire != wire_bytes {
+        return guard.fail(&mut state, "native_ocr_image_wire_forecast_changed");
+    }
+    state.image_wire_bytes = next;
+    if let Err(error) = guard.write_receipt(&format!("prepared-{ordinal}.json"), &json!({
+        "schema_version":guard.kind.receipt_schema(),"kind":"native_prepared_image",
+        "admission_sha256":guard.manifest_sha256,"task_sha256":guard.manifest.task_sha256,
+        "call_id":call_id,"ordinal":ordinal,"artifact_id":grant.artifact_id,
+        "source_buffer_sha256":grant.sha256,"prepared_image_bytes":bytes.len(),
+        "prepared_image_sha256":digest(bytes),"source_width":grant.width,"source_height":grant.height,
+        "prepared_width":width,"prepared_height":height,"image_wire_bytes":wire_bytes,
+        "cumulative_image_wire_bytes":next,"provider_ingestion_verified":false
+    })) { return guard.fail(&mut state, error); }
+    state.calls.get_mut(call_id).ok_or("native_ocr_assembly_call_unknown")?.prepared = Some(PreparedBinding {
+        bytes:bytes.len() as u64, sha256:digest(bytes), width,height,wire_bytes,
+    });
+    Ok(())
+}
+
+fn assembled_image(&self, call_id: Option<&str>, image: &codex_protocol::models::ImageReference)
+    -> AdmissionResult<()>
+{
+    let guard = self;
+    let mut state = guard.state.lock().map_err(|_| "native_ocr_guard_poisoned")?;
+    if let Err(error) = guard.check(&state) { return guard.fail(&mut state, error); }
+    let Some(call_id) = call_id else { return guard.fail(&mut state, "native_ocr_assembly_call_missing"); };
+    let Some(call) = state.calls.get(call_id) else {
+        return guard.fail(&mut state, "native_ocr_assembly_call_unknown");
+    };
+    let Some(grant) = call.grant.clone() else {
+        return guard.fail(&mut state, "native_ocr_assembly_grant_missing");
+    };
+    let ordinal = call.ordinal;
+    let Some(prepared) = call.prepared.clone() else {
+        return guard.fail(&mut state, "native_ocr_prepared_image_missing");
+    };
+    if call.assembled { return guard.fail(&mut state, "native_ocr_duplicate_assembly"); }
+    let reference = match image {
+        codex_protocol::models::ImageReference::Inline { image_url } => {
+            let (prefix, payload) = image_url.split_once(',').ok_or("native_ocr_assembled_image_format")?;
+            if !prefix.starts_with("data:") || !prefix.ends_with(";base64")
+                || image_url.len() as u64 > FRAME_LIMIT
+            { return guard.fail(&mut state, "native_ocr_assembled_image_format"); }
+            let bytes = base64::engine::general_purpose::STANDARD.decode(payload)
+                .map_err(|_| "native_ocr_assembled_image_format")?;
+            if bytes.len() as u64 != prepared.bytes || digest(&bytes) != prepared.sha256 {
+                return guard.fail(&mut state, "native_ocr_upload_payload_changed");
+            }
+            json!({"type":"inline","bytes":bytes.len(),"sha256":digest(&bytes)})
+        }
+        codex_protocol::models::ImageReference::File { file_id } => {
+            if file_id.is_empty() || file_id.len() > 256 {
+                return guard.fail(&mut state, "native_ocr_assembled_reference");
+            }
+            json!({"type":"file","reference_sha256":digest(file_id.as_bytes())})
+        }
+    };
+    if let Err(error) = guard.write_receipt(&format!("assembled-{ordinal}.json"), &json!({
+        "schema_version":guard.kind.receipt_schema(),"kind":"native_image_assembled",
+        "admission_sha256":guard.manifest_sha256,"task_sha256":guard.manifest.task_sha256,
+        "call_id":call_id,"ordinal":ordinal,"artifact_id":grant.artifact_id,
+        "source_buffer_sha256":grant.sha256,"reference":reference,
+        "prepared_image_sha256":prepared.sha256,"prepared_image_bytes":prepared.bytes,
+        "prepared_width":prepared.width,"prepared_height":prepared.height,
+        "image_content_wire_charge":prepared.wire_bytes,
+        "local_assembly_verified":true,"provider_ingestion_verified":false
+    })) { return guard.fail(&mut state, error); }
+    state.calls.get_mut(call_id).ok_or("native_ocr_assembly_call_unknown")?.assembled = true;
+    Ok(())
+}
+
+fn before_model_request(&self, model: &str, effort: Option<&ReasoningEffort>, tier: Option<&str>)
+    -> AdmissionResult<()>
+{
+    let guard = self;
+    let mut state = guard.state.lock().map_err(|_| "native_ocr_guard_poisoned")?;
+    if let Err(error) = guard.check(&state) { return guard.fail(&mut state, error); }
+    if state.turns != 1 || state.turn_id.is_none() || model != "gpt-6-luna"
+        || effort != Some(&ReasoningEffort::Max) || tier != Some("priority")
+        || state.calls.values().any(|call| call.native_image && !call.assembled)
+    { return guard.fail(&mut state, "native_ocr_model_request_not_admitted"); }
+    Ok(())
+}
