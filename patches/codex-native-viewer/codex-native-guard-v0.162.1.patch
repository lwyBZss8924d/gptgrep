+/// App-server initialize echoes this value. Missing/invalid required state fails initialize.
+pub fn ready() -> AdmissionResult<Option<Value>> {
+    let Some(guard) = get()? else { return Ok(None); };
+    let state = guard.state.lock().map_err(|_| "native_ocr_guard_poisoned")?;
+    guard.check(&state)?;
+    Ok(Some(guard.ready_value()))
+}
