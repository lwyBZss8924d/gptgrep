+    -> AdmissionResult<()>
+{
+    let Some(guard) = get()? else { return Ok(()); };
+    guard.before_model_request(model, effort, tier)
+}
+
+fn validate_absolute(path: &Path) -> AdmissionResult<()> {
+    if !path.is_absolute() || path.components().any(|part| matches!(part, Component::CurDir | Component::ParentDir))
+        || path.to_str().is_none() || path.as_os_str().len() > 4096
+        || fs::canonicalize(path).map_err(|_| "native_ocr_path_unavailable")? != path
+    { return Err("native_ocr_path_not_canonical"); }
+    Ok(())
+}
+
+#[cfg(unix)]
+fn open_directory(path: &Path) -> AdmissionResult<File> {
+    use std::os::unix::fs::OpenOptionsExt;
+    validate_absolute(path)?;
+    OpenOptions::new().read(true).custom_flags(libc::O_DIRECTORY | libc::O_NOFOLLOW | libc::O_CLOEXEC)
+        .open(path).map_err(|_| "native_ocr_directory_open")
+}
+
+#[cfg(unix)]
+fn same_directory(path: &Path, held: &File) -> AdmissionResult<()> {
+    use std::os::unix::fs::MetadataExt;
+    let metadata = fs::symlink_metadata(path).map_err(|_| "native_ocr_directory_changed")?;
+    let original = held.metadata().map_err(|_| "native_ocr_directory_changed")?;
+    if !metadata.is_dir() || metadata.dev() != original.dev() || metadata.ino() != original.ino() {
+        return Err("native_ocr_directory_changed");
+    }
+    Ok(())
+}
+
+#[cfg(unix)]
+fn open_leaf(directory: &File, path: &Path) -> AdmissionResult<File> {
+    use std::os::fd::{AsRawFd, FromRawFd};
+    use std::os::unix::ffi::OsStrExt;
+    let name = std::ffi::CString::new(path.as_os_str().as_bytes()).map_err(|_| "native_ocr_leaf_name")?;
+    // SAFETY: held directory is live, name is NUL-terminated, returned descriptor is owned here.
+    let fd = unsafe { libc::openat(directory.as_raw_fd(), name.as_ptr(), libc::O_RDONLY | libc::O_NOFOLLOW | libc::O_NONBLOCK | libc::O_CLOEXEC) };
+    if fd < 0 { return Err("native_ocr_leaf_open"); }
+    let file = unsafe { File::from_raw_fd(fd) };
+    use std::os::unix::fs::MetadataExt;
+    let metadata = file.metadata().map_err(|_| "native_ocr_leaf_metadata")?;
+    if !metadata.is_file() || metadata.nlink() != 1 { return Err("native_ocr_leaf_not_regular"); }
+    Ok(file)
+}
+
+#[cfg(unix)]
+fn create_leaf(directory: &File, leaf: &str) -> AdmissionResult<File> {
+    use std::os::fd::{AsRawFd, FromRawFd};
+    let name = std::ffi::CString::new(leaf).map_err(|_| "native_ocr_leaf_name")?;
+    // SAFETY: generated single-component leaf and held directory descriptor.
+    let fd = unsafe { libc::openat(directory.as_raw_fd(), name.as_ptr(), libc::O_WRONLY | libc::O_CREAT | libc::O_EXCL | libc::O_NOFOLLOW | libc::O_CLOEXEC, 0o600) };
+    if fd < 0 { return Err("native_ocr_receipt_open"); }
+    Ok(unsafe { File::from_raw_fd(fd) })
+}
+
+#[cfg(unix)]
+fn read_sealed_file(path: &Path, limit: u64) -> AdmissionResult<Vec<u8>> {
+    use std::os::unix::fs::MetadataExt;
+    use std::os::unix::fs::OpenOptionsExt;
+    validate_absolute(path)?;
+    let mut file = OpenOptions::new().read(true).custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK | libc::O_CLOEXEC)
+        .open(path).map_err(|_| "native_ocr_manifest_open")?;
+    let before = file.metadata().map_err(|_| "native_ocr_manifest_metadata")?;
+    if !before.is_file() || before.nlink() != 1 || before.len() > limit {
+        return Err("native_ocr_manifest_limit");
+    }
+    let mut bytes = Vec::with_capacity(before.len() as usize);
+    (&mut file).take(limit + 1).read_to_end(&mut bytes).map_err(|_| "native_ocr_manifest_read")?;
+    let after = file.metadata().map_err(|_| "native_ocr_manifest_metadata")?;
+    if bytes.len() as u64 != before.len() || after.len() != before.len()
+        || (after.mtime(), after.mtime_nsec(), after.ctime(), after.ctime_nsec())
+            != (before.mtime(), before.mtime_nsec(), before.ctime(), before.ctime_nsec())
+    { return Err("native_ocr_manifest_changed"); }
+    Ok(bytes)
+}
+
+
+#[cfg(unix)]
+fn same_regular_file(path: &Path, held: &File) -> AdmissionResult<()> {
+    use std::os::unix::fs::MetadataExt;
+    let current = fs::symlink_metadata(path).map_err(|_| "native_document_catalogue_changed")?;
+    let original = held.metadata().map_err(|_| "native_document_catalogue_changed")?;
+    if !current.is_file() || current.nlink() != 1 || original.nlink() != 1
+        || current.dev() != original.dev() || current.ino() != original.ino()
+    { return Err("native_document_catalogue_changed"); }
+    Ok(())
+}
+
+#[cfg(unix)]
+fn open_catalogue(pin: &ImageCataloguePin) -> AdmissionResult<File> {
+    use std::os::unix::fs::OpenOptionsExt;
+    validate_absolute(&pin.path)?;
+    let mut file = OpenOptions::new().read(true)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK | libc::O_CLOEXEC)
+        .open(&pin.path).map_err(|_| "native_document_catalogue_open")?;
+    same_regular_file(&pin.path, &file)?;
+    scan_catalogue(&mut file, pin, None)?;
+    Ok(file)
+}
+
+#[cfg(unix)]
+fn scan_catalogue(file: &mut File, pin: &ImageCataloguePin, selected: Option<&Path>)
+    -> AdmissionResult<Option<ImageGrant>>
+{
+    use std::os::unix::fs::MetadataExt;
+    same_regular_file(&pin.path, file)?;
+    let before = file.metadata().map_err(|_| "native_document_catalogue_metadata")?;
+    if pin.bytes > CATALOGUE_LIMIT || before.len() != pin.bytes || !valid_digest(&pin.sha256) {
+        return Err("native_document_catalogue_limit");
+    }
+    file.seek(SeekFrom::Start(0)).map_err(|_| "native_document_catalogue_seek")?;
+    let mut reader = BufReader::with_capacity(CATALOGUE_ROW_LIMIT, (&mut *file).take(pin.bytes + 1));
+    let mut hasher = Sha256::new();
+    let mut total = 0u64;
+    let mut count = 0u32;
+    let mut previous: Option<PathBuf> = None;
+    let mut ids = BTreeSet::new();
+    let mut id_bytes = 0usize;
+    let mut found = None;
+    loop {
+        let mut row = Vec::with_capacity(CATALOGUE_ROW_LIMIT);
+        loop {
+            let available = reader.fill_buf().map_err(|_| "native_document_catalogue_read")?;
+            if available.is_empty() {
+                if !row.is_empty() { return Err("native_document_catalogue_missing_lf"); }
+                break;
+            }
+            let newline = available.iter().position(|byte| *byte == b'\n');
+            let consumed = newline.map_or(available.len(), |index| index + 1);
+            if row.len().checked_add(consumed).is_none_or(|n| n > CATALOGUE_ROW_LIMIT) {
+                return Err("native_document_catalogue_row_limit");
+            }
+            row.extend_from_slice(&available[..consumed]);
+            reader.consume(consumed);
+            if newline.is_some() { break; }
+        }
+        if row.is_empty() { break; }
+        total = total.checked_add(row.len() as u64).ok_or("native_document_catalogue_overflow")?;
+        if total > pin.bytes { return Err("native_document_catalogue_changed"); }
+        hasher.update(&row);
+        let grant: ImageGrant = serde_json::from_slice(&row)
+            .map_err(|_| "native_document_catalogue_row_schema")?;
+        validate_grant(&grant)?;
+        if previous.as_ref().is_some_and(|prior| prior >= &grant.relative_path)
+            || !ids.insert(grant.artifact_id.clone())
+        { return Err("native_document_catalogue_order_or_identity"); }
+        id_bytes = id_bytes.checked_add(grant.artifact_id.len())
+            .ok_or("native_document_catalogue_overflow")?;
+        // Raw catalogue <=4MiB also bounds the retained identity set and node count.
+        if id_bytes as u64 > pin.bytes { return Err("native_document_catalogue_identity_limit"); }
+        previous = Some(grant.relative_path.clone());
+        count = count.checked_add(1).ok_or("native_document_catalogue_overflow")?;
+        if selected == Some(grant.relative_path.as_path()) { found = Some(grant); }
+    }
+    drop(reader);
+    let after = file.metadata().map_err(|_| "native_document_catalogue_metadata")?;
+    same_regular_file(&pin.path, file)?;
+    if total != pin.bytes || count != pin.count || format!("{:x}", hasher.finalize()) != pin.sha256
+        || (before.len(), before.mtime(), before.mtime_nsec(), before.ctime(), before.ctime_nsec())
+            != (after.len(), after.mtime(), after.mtime_nsec(), after.ctime(), after.ctime_nsec())
+    { return Err("native_document_catalogue_changed"); }
+    Ok(found)
+}
