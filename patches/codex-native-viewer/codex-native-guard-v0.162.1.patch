+#[cfg(test)]
+mod initialize_native_ready_tests {
+    use super::InitializeResponse;
+    use codex_utils_absolute_path::AbsolutePathBuf;
+    use serde_json::json;
+
+    fn ordinary() -> InitializeResponse {
+        InitializeResponse {
+            user_agent: "test".into(),
+            codex_home: AbsolutePathBuf::from_absolute_path("/native-test").unwrap(),
+            platform_family: "unix".into(),
+            platform_os: "macos".into(),
+            gptgrep_native_ocr: None,
+            gptgrep_native_document: None,
+        }
+    }
+
+    #[test]
+    fn ordinary_initialize_wire_omits_both_native_fields_and_accepts_old_wire() {
+        let expected = br#"{"userAgent":"test","codexHome":"/native-test","platformFamily":"unix","platformOs":"macos"}"#;
+        assert_eq!(serde_json::to_vec(&ordinary()).unwrap(), expected);
+        let parsed: InitializeResponse = serde_json::from_slice(expected).unwrap();
+        assert_eq!(parsed, ordinary());
+    }
+
+    #[test]
+    fn typed_initialize_payload_preserves_the_selected_ready_namespace_only() {
+        for document in [false, true] {
+            let mut response = ordinary();
+            let ready = json!({"schema_version": if document {
+                "gptgrep.native-document.ready.v1"
+            } else {
+                "gptgrep.native-ocr.ready.v1"
+            }, "required": true});
+            let (present, absent) = if document {
+                response.gptgrep_native_document = Some(ready.clone());
+                ("gptgrepNativeDocument", "gptgrepNativeOcr")
+            } else {
+                response.gptgrep_native_ocr = Some(ready.clone());
+                ("gptgrepNativeOcr", "gptgrepNativeDocument")
+            };
+            let payload: crate::ClientResponsePayload = response.into();
+            let (_, result) = payload.to_jsonrpc_parts(crate::RequestId::Integer(1)).unwrap();
+            assert_eq!(result[present], ready);
+            assert!(result.get(absent).is_none());
+        }
+    }
+}
