+#[test_case(true ; "follow")]
+#[test_case(false ; "no_follow")]
+#[tokio::test]
+async fn caller_ceiling_refuses_before_allocation_and_preserves_exact_limit(
+    follow_symlinks: bool,
+) -> anyhow::Result<()> {
+    let directory = TempDir::new()?;
+    let path = directory.path().canonicalize()?.join("bounded.bin");
+    std::fs::write(&path, b"abcde")?;
+    let uri = PathUri::from_host_native_path(&path)?;
+    let limited = ReadFileOptions { follow_symlinks, max_bytes: Some(4) };
+    let error = LOCAL_FS.read_file(&uri, limited, None).await
+        .expect_err("caller limit below size must be rejected");
+    assert_eq!(error.kind(), std::io::ErrorKind::InvalidInput);
+    assert!(error.to_string().contains("4 bytes"));
+    let exact = ReadFileOptions { follow_symlinks, max_bytes: Some(5) };
+    assert_eq!(LOCAL_FS.read_file(&uri, exact, None).await?, b"abcde");
+    let oversized = ReadFileOptions { follow_symlinks, max_bytes: Some(u64::MAX) };
+    std::fs::File::create(&path)?.set_len(MAX_READ_FILE_BYTES + 1)?;
+    let error = LOCAL_FS.read_file(&uri, oversized, None).await
+        .expect_err("caller cannot enlarge hard cap");
+    assert_eq!(error.kind(), std::io::ErrorKind::InvalidInput);
+    Ok(())
+}
