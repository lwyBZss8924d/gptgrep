+/// Called before the constructed turn becomes runnable. The single turn is consumed on admission.
+pub(crate) fn admit_turn(turn: &TurnContext) -> AdmissionResult<()> {
+    let Some(guard) = get()? else { return Ok(()); };
+    let mut state = guard.state.lock().map_err(|_| "native_ocr_guard_poisoned")?;
+    if let Err(error) = guard.check(&state) { return guard.fail(&mut state, error); }
+    state.turns = state.turns.checked_add(1).ok_or("native_ocr_turn_count_overflow")?;
+    if state.turns != 1 || state.turn_id.is_some() {
+        return guard.fail(&mut state, "native_ocr_turn_budget_exhausted");
+    }
+    if turn.initial_environments.environments.len() != 1 {
+        return guard.fail(&mut state, "native_ocr_environment_selection");
+    }
+    let selections = turn.initial_environments.all_selections();
+    if let Err(error) = validate_environment_selection(
+        &selections[0], &guard.manifest.image_root,
+    ) {
+        return guard.fail(&mut state, error);
+    }
+    let permissions = normalized_permissions(&turn.permission_profile())?;
+    if permissions != guard.expected_permissions {
+        return guard.fail(&mut state, "native_ocr_turn_permission_value_mismatch");
+    }
+    if turn.config.permissions.active_permission_profile().as_ref()
+        .is_none_or(|profile| profile.id != guard.kind.profile_id())
+    {
+        return guard.fail(&mut state, "native_ocr_turn_active_profile_id_mismatch");
+    }
+    if turn.config.permissions.approval_policy.value() != AskForApproval::Never {
+        return guard.fail(&mut state, "native_ocr_turn_approval_policy_mismatch");
+    }
+    if turn.initial_settings.model_info.slug != "gpt-6-luna" {
+        return guard.fail(&mut state, "native_ocr_turn_model_mismatch");
+    }
+    if turn.initial_settings.effective_reasoning_effort() != Some(ReasoningEffort::Max) {
+        return guard.fail(&mut state, "native_ocr_turn_effort_mismatch");
+    }
+    if turn.initial_settings.service_tier.as_deref() != Some("priority") {
+        return guard.fail(&mut state, "native_ocr_turn_service_tier_mismatch");
+    }
+    state.turn_id = Some(turn.sub_id.clone());
+    if let Err(error) = guard.write_receipt("turn.json", &json!({
+        "schema_version":guard.kind.receipt_schema(),"kind":"turn_admitted",
+        "admission_sha256":guard.manifest_sha256,
+        "task_sha256":guard.manifest.task_sha256,
+        "turn_id":turn.sub_id,"max_turns":1,
+        "permissions_profile_sha256":guard.manifest.permissions_profile_sha256
+    })) { return guard.fail(&mut state, error); }
+    Ok(())
+}
