+/// Called after native resize/encoding, before attachment upload/outgoing image assembly.
+/// The 8 MiB reservation is disjoint from the host's 8 MiB RPC allowance.
+pub(crate) fn prepared_image(
+    call_id: Option<&str>, bytes: &[u8], mime: &str, width: u32, height: u32,
+    detail: Option<codex_protocol::models::ImageDetail>,
