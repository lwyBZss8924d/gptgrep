+
+fn planned_image_wire_bytes(
+    call_id: &str, payload_bytes: usize, mime: &str,
+    detail: Option<codex_protocol::models::ImageDetail>,
+) -> AdmissionResult<u64> {
+    if !matches!(mime, "image/png" | "image/jpeg" | "image/webp" | "image/gif") {
+        return Err("native_ocr_prepared_mime");
+    }
+    let length = u64::try_from(payload_bytes).map_err(|_| "native_ocr_transport_overflow")?;
+    let encoded = length.checked_add(2).and_then(|value| value.checked_div(3))
+        .and_then(|value| value.checked_mul(4)).ok_or("native_ocr_transport_overflow")?;
+    let framing = image_wire_bytes(call_id,
+        codex_protocol::models::ImageReference::Inline {
+            image_url: format!("data:{mime};base64,"),
+        }, detail)?;
+    framing.checked_add(encoded).ok_or("native_ocr_transport_overflow")
+}
+
+fn image_wire_bytes(call_id: &str, image: codex_protocol::models::ImageReference,
+    detail: Option<codex_protocol::models::ImageDetail>) -> AdmissionResult<u64>
+{
+    use codex_protocol::models::{FunctionCallOutputBody, FunctionCallOutputContentItem,
+        FunctionCallOutputPayload, ResponseInputItem};
+    let item = ResponseInputItem::FunctionCallOutput {
+        call_id:call_id.to_owned(),
+        output:FunctionCallOutputPayload {
+            body:FunctionCallOutputBody::ContentItems(vec![FunctionCallOutputContentItem::InputImage {
+                image,detail,
+            }]),success:Some(true),
+        },
+    };
+    serde_json::to_vec(&item).map(|bytes| bytes.len() as u64)
+        .map_err(|_| "native_ocr_image_wire_serialization")
+}
