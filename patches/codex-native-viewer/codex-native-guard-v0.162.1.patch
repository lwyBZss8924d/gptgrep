+/// Validate the completed HTTP/WebSocket request after all profile normalization.
+pub(crate) fn before_wire_request(
+    request: &codex_api::ResponsesApiRequest, warmup: bool,
+) -> AdmissionResult<()> {
+    let Some(guard) = get()? else { return Ok(()); };
+    let tools = match request.tools.as_ref() {
+        Some(tools) => {
+            let raw = tools.as_raw_value().get();
+            if raw.len() > MANIFEST_LIMIT {
+                let mut state = guard.state.lock().map_err(|_| "native_ocr_guard_poisoned")?;
+                return guard.fail(&mut state, "native_ocr_tool_schema_limit");
+            }
+            match serde_json::from_str(raw) {
+                Ok(value) => Some(value),
+                Err(_) => {
+                    let mut state = guard.state.lock().map_err(|_| "native_ocr_guard_poisoned")?;
+                    return guard.fail(&mut state, "native_ocr_tool_schema");
+                }
+            }
+        }
+        None => None,
+    };
+    guard.before_wire_request(
+        &request.model,
+        request.reasoning.as_ref().and_then(|reasoning| reasoning.effort.as_ref()),
+        request.service_tier.as_deref(), tools.as_ref(), warmup,
+    )
+}
+
+fn validate_model_tools(tools: Option<&Value>, kind: GuardKind) -> AdmissionResult<()> {
+    let Some(Value::Array(tools)) = tools else { return Err("native_ocr_tool_schema"); };
+    if tools.len() > MAX_TOOLS as usize { return Err("native_ocr_tool_schema"); }
+    let mut admitted = BTreeSet::new();
+    fn function(tool: &Value, namespace: Option<&str>, admitted: &mut BTreeSet<String>, kind: GuardKind)
+        -> AdmissionResult<()>
+    {
+        if tool.get("type").and_then(Value::as_str) != Some("function") {
+            return Err("native_ocr_model_tool_not_admitted");
+        }
+        let name = tool.get("name").and_then(Value::as_str)
+            .ok_or("native_ocr_tool_schema")?;
+        let key = match (namespace, name) {
+            (None | Some("functions"), "view_image") => "view_image",
+            (Some(namespace), name) if namespace == kind.context_namespace()
+                && name == kind.context_name() => kind.context_key(),
+            _ => return Err("native_ocr_model_tool_not_admitted"),
+        };
+        if !admitted.insert(key.into()) { return Err("native_ocr_duplicate_model_tool"); }
+        Ok(())
+    }
+    for tool in tools {
+        if tool.get("type").and_then(Value::as_str) == Some("namespace") {
+            let namespace = tool.get("name").and_then(Value::as_str)
+                .ok_or("native_ocr_tool_schema")?;
+            let nested = tool.get("tools").and_then(Value::as_array)
+                .ok_or("native_ocr_tool_schema")?;
+            if nested.len() > MAX_TOOLS as usize { return Err("native_ocr_tool_schema"); }
+            for tool in nested { function(tool, Some(namespace), &mut admitted, kind)?; }
+        } else {
+            function(tool, None, &mut admitted, kind)?;
+        }
+    }
+    if admitted.len() != 2 || !admitted.contains("view_image")
+        || !admitted.contains(kind.context_key())
+    {
+        return Err("native_ocr_required_model_tool_missing");
+    }
+    Ok(())
+}
